# AYR Steel ERP - Environment Variables Template
# Copy this file to .env and fill in the values

# --- FIREBASE CLIENT CONFIG (Next.js) ---
# Find these in Firebase Console > Project Settings > General > Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# --- ALGOLIA CONFIG ---
# Find these in Algolia Dashboard > API Keys
NEXT_PUBLIC_ALGOLIA_APP_ID=your_algolia_app_id
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=your_algolia_search_only_key
ALGOLIA_ADMIN_KEY=your_algolia_admin_key_for_scripts_only

# --- SUNAT & APIS PERU CONFIG ---
# APIS PERU (DNI/RUC Lookup)
APIS_PERU_TOKEN=your_apis_peru_token

# SUNAT Credentials (SOL)
SUNAT_RUC=your_company_ruc
SUNAT_USER_SOL=your_sol_user
SUNAT_PASS_SOL=your_sol_password

# SUNAT API (OAuth2 / REST)
SUNAT_CLIENT_ID=your_sunat_client_id
SUNAT_CLIENT_SECRET=your_sunat_client_secret

# SUNAT Validez CPE (OAuth2)
SUNAT_CONSULTA_CLIENT_ID=your_validez_client_id
SUNAT_CONSULTA_CLIENT_SECRET=your_validez_client_secret

# SUNAT Digital Certificate
# Convert your .p12/.pfx to base64: [Convert]::ToBase64String([IO.File]::ReadAllBytes("cert.p12"))
SUNAT_CERT_BASE64=your_certificate_in_base64
SUNAT_CERT_PASSWORD=your_certificate_password

# --- APP CONFIG ---
NEXT_PUBLIC_APP_ENV=development
EMPRESA_RAZON_SOCIAL="AYR STEEL S.A.C."
DIRECCION_PARTIDA="AV. PRINCIPAL MZ. A LOTE. 1"
UBIGEO_PARTIDA="250101"

# --- ADMIN & SCRIPTS ---
# Path to Firebase Service Account JSON or the JSON string itself
# Used by migration and seeding scripts
FIREBASE_SERVICE_ACCOUNT=path/to/serviceAccountKey.json
FIREBASE_PROJECT_ID=your_project_id
GOOGLE_APPLICATION_CREDENTIALS=path/to/serviceAccountKey.json

# Seed configurations
SEED_DRY_RUN=1
