sales_test_approval_backup_*.json
sales_quotation_prod_backup_*.json
sales_quotation_test_backup_*.json

# Scripts ad-hoc de recon/migracion/purga (no versionar)
/scripts/*.cjs
/scripts/*.ts
# Excepcion: infraestructura permanente referenciada desde package.json,
# no scripts ad-hoc de un solo uso (esos van a ~/ayr-scratch/ por regla de oro).
!scripts/emuPortGuard.cjs
!scripts/emuPortGuard.test.cjs
!scripts/emuStaleGuard.cjs
!scripts/emuStaleGuard.test.cjs
!scripts/with-emulator.cjs
!scripts/check-docs.cjs
!scripts/checkDocs.test.cjs
