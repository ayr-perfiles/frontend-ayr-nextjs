/functions/script.js
/functions/checkCatalog.js
/functions/scripts/
/functions-sunat/lib/
/functions-sunat/dump_*.js
/functions-sunat/recon_*.cjs
# Backups y dumps (pueden traer data de prod — NUNCA versionar)
/backup_recon_*.json
/sales_full_*_backup_*.json
/scripts/ids_to_purge.json
/*_backup_*.json
# Salidas temporales
/build_output*.txt
/dump_test_emu.txt
/commit_msg.txt
/current_fix.patch
/tmp*.txt
/scratch/
*.bat
# Editor/agente
/.claude/
# Artefactos generados por el MCP de Playwright (snapshots/screenshots/logs), no versionar
/.playwright-mcp/

# Scripts one-shot de recon/backup/verify/post-mortem (NUNCA versionar, viven en ~/ayr-scratch/)
/micro_recon*.cjs
/backup_fase*.cjs
/delete_fase*.cjs
/verify_*.cjs
/post_mortem*.cjs
/*_dump.json
/dump_*.txt
/final_output.json
/read_a2.cjs
/read_backup.cjs
/recon.cjs

# [E2E-HARNESS] (COLA #6, v6.90.0) — estado de sesion del harness de Playwright.
# Lo escribe el globalSetup tras el login de sonda: son TOKENS de una cuenta
# real de `ayrsteel-test`. Nunca se versiona. Los .ts de `e2e/` SI se versionan
# (verificado con `git check-ignore`: ninguna regla los tapaba).
/e2e/.auth/

# [E2E-HARNESS] (COLA #6, v6.90.0) — dist dir propio del harness. `next dev`
# toma un lock exclusivo en <distDir>/dev/lock, asi que el harness no puede
# compartir `.next` con el `next dev` del dueno. Ver next.config.ts.
/.next-e2e/
