# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Firebase emulator data (ephemeral, not for git)
/firebase-data/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
*-debug.log
firebase-debug.log
firestore-debug.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
serviceAccountKey.json
serviceAccountKeyTest.json
serviceAccount.json

# Scripts y archivos temporales de migración/pruebas (no versionar)
/scripts/local/
/prod-indexes.json
/prod-indexes-final.json
/run_backfill_api.*
/run_check_coils.js
/test-matrix.cjs
/test-rules.js
