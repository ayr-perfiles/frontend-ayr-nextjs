rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ──── HELPERS ────
    function isSignedIn() {
      return request.auth != null;
    }
    function hasRole(r) {
      return isSignedIn() && 'role' in request.auth.token && request.auth.token.role == r;
    }
    function isAdmin() {
      return isSignedIn() && 'role' in request.auth.token && request.auth.token.role == 'ADMIN';
    }
    function isStaff() {
      return isSignedIn() && 'role' in request.auth.token && request.auth.token.role in ['ADMIN', 'SUPERVISOR', 'OPERATOR'];
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function fieldsUnchanged(fields) {
      // Evita errores si se evalúa cuando resource es nulo (aunque no debería pasar en update)
      return resource == null || !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // ──── USERS ────
    match /users/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isOwner(uid) && fieldsUnchanged(['role', 'isActive']));
    }

    // ──── SETTINGS & INTEGRATIONS ────
    match /settings/{document=**} {
      allow read, write: if isAdmin();
    }
    match /integrations/{document=**} {
      allow read, write: if isAdmin();
    }

    // ──── CATALOGS (Products) ────
    match /products/{document=**} { allow read: if isStaff(); allow write: if isAdmin() || hasRole('SUPERVISOR'); }
    match /roofing_catalog/{document=**} { allow read: if isStaff(); allow write: if isAdmin() || hasRole('SUPERVISOR'); }
    match /metallic_roofing_catalog/{document=**} { allow read: if isStaff(); allow write: if isAdmin() || hasRole('SUPERVISOR'); }
    match /trading_catalog/{document=**} { allow read: if isStaff(); allow write: if isAdmin() || hasRole('SUPERVISOR'); }
    match /services_catalog/{document=**} { allow read: if isStaff(); allow write: if isAdmin() || hasRole('SUPERVISOR'); }

    // ──── PURCHASES ────
    match /purchases/{document=**} {
      allow read: if isAdmin() || hasRole('SUPERVISOR');
      allow write: if isAdmin() || hasRole('SUPERVISOR');
    }

    // ──── AUDIT LOGS ────
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isStaff();
      allow update, delete: if false; // Append-only
    }

    // ──── CORE BUSINESS: Ventas, Bobinas, Inventarios, Producción ────
    // (FASE 1: Escritura abierta a isStaff() para no romper cliente, pero bloqueando mutación de campos críticos)
    
    match /sales/{saleId} {
      allow read: if isStaff();
      // FASE 2: cerrar a if false cuando exista la Cloud Function createSale
      allow create: if isStaff();
      // Protegemos el SNAPSHOT financiero de la venta. 'status' sigue mutable client-side
      // (approveQuotation -> CONVERTED, cancelQuotation -> CANCELLED, ambos vivos y
      // client-side todavía) con 2 excepciones candadas al callable annulSale
      // (functions/src/callables/sales.ts, Admin SDK, bypassea esta regla):
      // 1) nadie transiciona a VOIDED desde el cliente (cierra el bypass documentado de
      //    anular sin pasar por el bloqueo de producción activa ni la cascada — ver
      //    CLAUDE.md deuda "annulSale D1 es client-side").
      // 2) un doc ya VOIDED queda terminal/congelado — ningún campo se toca desde el
      //    cliente una vez anulado (cierra tambien el gap de approveQuotation, cuyo
      //    guard hoy es negativo y no excluye VOIDED explicitamente — ver recon).
      allow update: if isStaff()
        && fieldsUnchanged(['totalAmount', 'subtotal', 'igv', 'exchangeRate', 'currency', 'items', 'paymentType'])
        && !(request.resource.data.status == 'VOIDED' && resource.data.status != 'VOIDED')
        && !(resource.data.status == 'VOIDED');
      allow delete: if isAdmin();
      
      match /history/{historyId} {
        allow read: if isStaff();
        allow write: if isStaff();
      }
    }

    match /customers/{customerId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /contacts/{contactId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /coils/{coilId} {
      allow read: if isStaff();
      // FASE 2: cerrar a if false cuando exista la Cloud Function (split/corte)
      allow create: if isStaff();
      allow update: if isStaff(); // Relajado para admitir edición de inicial/costo o consumo
      allow delete: if isAdmin();
    }

    match /cut_orders/{orderId} {
      allow read: if isStaff();
      // FASE 2: cerrar a if false
      allow create: if isStaff();
      allow update: if isStaff(); // Muta 'status', 'coils', 'sentWeightTotal' en el cliente
      allow delete: if isAdmin();
    }

    match /strips_stock/{stripId} {
      allow read: if isStaff();
      // FASE 2: cerrar a if false
      allow create: if isStaff();
      allow update: if isStaff(); // Muta 'avgCostPerKg', 'totalStrips', 'totalWeight' en el cliente
      allow delete: if isAdmin();
    }

    match /strips_movements/{movId} {
      allow read: if isStaff();
      // FASE 2: cerrar a if false
      allow create: if isStaff();
      allow update, delete: if false; // Trazabilidad append-only o functions
    }


    match /production_logs/{logId} {
      allow read: if isStaff();
      // FASE 2: cerrar a if false
      allow create: if isStaff();
      // Protegemos el SNAPSHOT de producción. Se permite cambiar 'status' en anulaciones
      allow update: if isStaff() && fieldsUnchanged(['piecesProduced', 'sku', 'line', 'costPerPiece', 'baseCost', 'weightUsed', 'stripId', 'coilId']);
      allow delete: if isAdmin();
    }

    match /inventory_stock/{itemId} {
      allow read: if isStaff();
      // FASE 2: cerrar a if false
      allow create: if isStaff();
      allow update: if isStaff(); // Muta 'stock', 'wac' desde el cliente en ventas/producción
      allow delete: if isAdmin();
    }

    match /kardex_movements/{movId} {
      allow read: if isStaff();
      // FASE 2: cerrar a if false
      allow create: if isStaff();
      allow update, delete: if false;
    }

    match /scrap_logs/{logId} {
      allow read: if isStaff();
      allow create: if false; // FASE 2: cerrado (registerCoilScrap Callable y frontend migrados)
      allow update, delete: if false;
    }

    match /roofing_stock/{document=**} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update: if isStaff(); // Muta stock/wac en cliente
      allow delete: if isAdmin();
    }
    match /roofing_stock_movements/{document=**} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if false;
    }
    match /metallic_roofing_stock/{document=**} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update: if isStaff(); // Muta stock/wac en cliente
      allow delete: if isAdmin();
    }
    match /metallic_roofing_stock_movements/{document=**} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if false;
    }
    match /trading_stock/{document=**} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update: if isStaff(); // Muta stock/wac en cliente
      allow delete: if isAdmin();
    }
    match /trading_stock_movements/{document=**} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if false;
    }
    match /services_stock_movements/{document=**} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    match /coil_finishes/{document=**} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /supplier_sku_map/{document=**} {
      allow read: if isStaff();
      allow write: if isAdmin() || hasRole('SUPERVISOR');
    }

    match /_noop_stock/{document=**} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /counters/{counterId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /sunatCounters/{counterId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /idempotency_keys/{keyId} {
      allow read, write: if false; // Solo backend
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}