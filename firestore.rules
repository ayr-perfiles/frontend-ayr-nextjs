rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function role() {
      return request.auth.token.role;
    }

    function isAdmin() {
      return isAuth() && role() == 'ADMIN';
    }

    function isSupervisor() {
      return isAuth() && role() == 'SUPERVISOR';
    }

    function isOperator() {
      return isAuth() && role() == 'OPERATOR';
    }

    function isAdminOrSupervisor() {
      return isAdmin() || isSupervisor();
    }

    function isAnyRole() {
      return isAdmin() || isSupervisor() || isOperator();
    }

    // ── users/{uid} ──────────────────────────────────────────────────────────
    // Cualquier usuario autenticado puede leer perfiles (necesario para
    // mostrar nombre del operario en logs). Solo el dueño puede escribir
    // su propio documento.
    match /users/{uid} {
      allow read: if isAuth();
      allow write: if isAuth() && request.auth.uid == uid;
    }

    // ── coils ────────────────────────────────────────────────────────────────
    // ADMIN y SUPERVISOR gestionan el inventario de bobinas madre.
    // Nunca se borran físicamente; se anulan cambiando status a VOIDED.
    match /coils/{coilId} {
      allow read: if isAuth();

      allow create: if isAdminOrSupervisor()
        && request.resource.data.initialWeight is number
        && request.resource.data.initialWeight > 0
        && request.resource.data.pricePerKg is number
        && request.resource.data.pricePerKg > 0
        && request.resource.data.status == 'AVAILABLE';

      allow update: if isAdminOrSupervisor()
        && request.resource.data.status in [
             'AVAILABLE', 'IN_PROGRESS', 'PROCESSED', 'VOIDED'
           ];

      allow delete: if false;
    }

    // ── sales ────────────────────────────────────────────────────────────────
    // ADMIN tiene acceso completo. SUPERVISOR solo puede crear cotizaciones
    // (status == 'QUOTATION'); la conversión/anulación es exclusiva de ADMIN.
    match /sales/{saleId} {
      allow read: if isAuth();

      allow create: if isAdminOrSupervisor()
        && (isAdmin() || request.resource.data.status == 'QUOTATION')
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.totalAmount is number
        && request.resource.data.totalAmount >= 0;

      allow update: if isAdmin();

      allow delete: if false;
    }

    // ── production_logs ──────────────────────────────────────────────────────
    // Cualquier rol puede registrar producción (create).
    // Solo ADMIN/SUPERVISOR pueden anular un log ACTIVE → VOIDED.
    match /production_logs/{logId} {
      allow read: if isAuth();

      allow create: if isAnyRole()
        && request.resource.data.piecesProduced is number
        && request.resource.data.piecesProduced > 0
        && request.resource.data.parentCoilId is string
        && request.resource.data.parentCoilId.size() > 0
        && request.resource.data.status == 'ACTIVE';

      allow update: if isAdminOrSupervisor()
        && resource.data.status == 'ACTIVE'
        && request.resource.data.status == 'VOIDED';

      allow delete: if false;
    }

    // ── inventory_stock ──────────────────────────────────────────────────────
    // ⛔ SOLO LECTURA. Escrito por transacciones del cliente (productionService
    // y salesService) — esas escrituras FALLARÁN hasta migrar a Cloud Functions.
    // Pendiente: implementar Cloud Function que reciba el evento de producción/venta
    // y actualice este documento con permisos de Admin SDK.
    match /inventory_stock/{stockId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // ── kardex_movements ─────────────────────────────────────────────────────
    // ⛔ SOLO LECTURA. Mismo caso que inventory_stock.
    // Los movimientos de entrada/salida se deben generar desde Cloud Functions.
    match /kardex_movements/{movId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // ── settings ─────────────────────────────────────────────────────────────
    // Configuración global del sistema. Exclusivo de ADMIN.
    // Secretos NUNCA aquí; solo en variables de entorno o Secret Manager.
    match /settings/{doc} {
      allow read, write: if isAdmin();
    }

    // ── products ─────────────────────────────────────────────────────────────
    // Catálogo de SKUs. Todos pueden leer (necesario para formularios).
    // Solo ADMIN puede modificar el catálogo.
    match /products/{productId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ── audit_logs ───────────────────────────────────────────────────────────
    // ⛔ SOLO LECTURA para ADMIN. Las escrituras ocurren hoy dentro de
    // transacciones del cliente (voidSale, voidProduction, etc.) — esas
    // escrituras FALLARÁN hasta migrar a Cloud Functions.
    // Objetivo: Cloud Function que emita el log con Admin SDK post-commit.
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── customers ────────────────────────────────────────────────────────────
    // CRM: ADMIN y SUPERVISOR gestionan clientes. El resto solo lee.
    match /customers/{customerId} {
      allow read: if isAuth();
      allow write: if isAdminOrSupervisor();
    }

    // ── contacts ─────────────────────────────────────────────────────────────
    // Contactos asociados a clientes. Mismo acceso que customers.
    match /contacts/{contactId} {
      allow read: if isAuth();
      allow write: if isAdminOrSupervisor();
    }

    // Nota: cualquier colección no listada aquí es denegada implícitamente
    // por Firestore (deny-by-default). No se necesita una regla catch-all.
  }
}
