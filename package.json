{
  "name": "frontend-ayr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "npm run start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest src/test/integration",
    "test:emu": "firebase emulators:exec \"vitest run src/test/integration --no-file-parallelism --maxWorkers 1\" --only auth,firestore,storage",
    "emulators": "firebase emulators:start --import=./firebase-data --export-on-exit",
    "emulate": "concurrently \"npm run emulators\" \"npm run dev\""
  },
  "dependencies": {
    "algoliasearch": "^5.49.2",
    "firebase": "^12.10.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.577.0",
    "next": "16.1.7",
    "nextjs-toploader": "^3.9.17",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hot-toast": "^2.6.0",
    "react-to-print": "^3.3.0",
    "recharts": "^3.8.1",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/ui": "^4.1.7",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.7",
    "firebase-admin": "^13.10.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}
