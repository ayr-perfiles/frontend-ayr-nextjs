{
  "name": "frontend-ayr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "npm run start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:tsc": "node scripts/check-tsc.cjs",
    "type-check": "npm run check:tsc",
    "check:docs": "node scripts/check-docs.cjs",
    "test": "vitest run",
    "test:e2e": "playwright test --config e2e/playwright.config.ts --project=importador",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:emu": "node scripts/with-emulator.cjs test:emu:inner",
    "test:emu:inner": "firebase emulators:exec --project ayrsteel-test \"vitest run --config vitest.emu.config.ts src/test/integration --no-file-parallelism --maxWorkers 1\" --only auth,firestore,storage,functions",
    "test:emu:functions": "node scripts/with-emulator.cjs test:emu:functions:inner",
    "test:emu:functions:inner": "firebase emulators:exec --project ayrsteel-test \"vitest run --config vitest.emu.config.ts functions/src/callables --no-file-parallelism --maxWorkers 1\" --only auth,firestore,storage,functions",
    "test:emu:rules": "node scripts/with-emulator.cjs test:emu:rules:inner",
    "test:emu:rules:inner": "firebase emulators:exec --project ayrsteel-test \"npx vitest run --config vitest.emu.config.ts src/test/rules --no-file-parallelism --maxWorkers 1\" --only firestore",
    "emulators": "firebase emulators:start --import=./firebase-data --export-on-exit",
    "emulate": "concurrently \"npm run emulators\" \"npm run dev\"",
    "seed:annul-fixtures": "tsx src/test/integration/fixtures/seedAnnulFixtures.cli.ts"
  },
  "dependencies": {
    "algoliasearch": "^5.49.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "firebase": "^12.10.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jszip": "^3.10.1",
    "lucide-react": "^0.577.0",
    "next": "16.1.7",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "radix-ui": "^1.6.7",
    "react": "19.2.3",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.3",
    "react-hot-toast": "^2.6.0",
    "react-to-print": "^3.3.0",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/ui": "^4.1.7",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.7",
    "firebase-admin": "^13.10.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}
