{
  "name": "@gsm/design-kit",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de diseño portable extraído de GSM Inventory: tokens, componentes shadcn/ui personalizados y textos de UI genéricos en español.",
  "type": "module",
  "sideEffects": ["*.css"],
  "exports": {
    ".": "./index.ts",
    "./styles.css": "./styles/globals.css",
    "./theme.css": "./tokens/theme.css",
    "./preset": "./tokens/tailwind-preset.ts",
    "./*": "./*"
  },
  "scripts": {
    "check": "node scripts/check-portability.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm check && pnpm typecheck",
    "preview": "next dev preview --port 3100"
  },
  "peerDependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.37.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependenciesMeta": {
    "react-day-picker": { "optional": true },
    "cmdk": { "optional": true }
  }
}
