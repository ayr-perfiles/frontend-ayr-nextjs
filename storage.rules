rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuth() && request.auth.token.role == 'ADMIN';
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // ── /invoices/{companyId}/{invoiceId} ─────────────────────────────────────
    // Facturas del sistema. Solo ADMIN puede leer; escritura desde Admin SDK
    // (Cloud Functions), nunca directamente desde el cliente.
    match /invoices/{companyId}/{invoiceId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── /temp-uploads/{userId}/{filename} ────────────────────────────────────
    // Zona de staging para subidas del usuario. Solo el dueño puede operar.
    // Limpiar con Cloud Function después de procesar (TTL recomendado: 24h).
    match /temp-uploads/{userId}/{filename} {
      allow read, write: if isOwner(userId);
    }

    // ── /public/{filename} ───────────────────────────────────────────────────
    // Assets públicos (logos, plantillas de impresión, etc.).
    // Cualquier usuario autenticado puede leer; escritura solo desde Admin SDK.
    match /public/{filename} {
      allow read: if isAuth();
      allow write: if false;
    }

    // Cualquier ruta no listada queda denegada implícitamente (deny-by-default).
  }
}
